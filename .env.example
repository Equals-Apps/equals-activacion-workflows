# Panel de Triggers — variables de entorno (v1, Equals11)
# Copiar a .env.local para desarrollo, y cargar en Vercel (Production) para el deploy.
# NUNCA commitear valores reales: .env.local y demás .env* están gitignoreados;
# solo este .env.example (sin valores) se versiona.

# --- n8n (workflow "New P&L creation") ---
# URL del webhook de n8n. En producción apunta al webhook real; en pruebas locales
# se puede apuntar a un listener descartable para no disparar el workflow real.
N8N_PLL_WEBHOOK_URL=
# Valor del header X-Webhook-Secret que exige el nodo Webhook en n8n. Server-side only:
# nunca se expone al cliente ni se loguea.
N8N_PLL_WEBHOOK_SECRET=

# --- n8n (workflows adicionales de Equals11) ---
# Un par URL + SECRET por workflow, mismo esquema que P&L. Mientras no estén seteadas, la card
# correspondiente se muestra deshabilitada ("No configurado todavía en n8n") en vez de un botón.
# pendiente de configurar en n8n
N8N_REVENUE_UPDATE_WEBHOOK_URL=
N8N_REVENUE_UPDATE_WEBHOOK_SECRET=
# pendiente de configurar en n8n
N8N_MONTHLY_REPORT_WEBHOOK_URL=
N8N_MONTHLY_REPORT_WEBHOOK_SECRET=
# pendiente de configurar en n8n
N8N_CASHFLOW_DB_WEBHOOK_URL=
N8N_CASHFLOW_DB_WEBHOOK_SECRET=
# pendiente de configurar en n8n
N8N_COGS_HOURS_WEBHOOK_URL=
N8N_COGS_HOURS_WEBHOOK_SECRET=
# pendiente de configurar en n8n
N8N_STATUS_SYNC_WEBHOOK_URL=
N8N_STATUS_SYNC_WEBHOOK_SECRET=
# pendiente de configurar en n8n
N8N_PNL_FOLDER_COPY_WEBHOOK_URL=
N8N_PNL_FOLDER_COPY_WEBHOOK_SECRET=
# pendiente de configurar en n8n
N8N_TIMEKEEPING_FOLDER_COPY_WEBHOOK_URL=
N8N_TIMEKEEPING_FOLDER_COPY_WEBHOOK_SECRET=
# pendiente de configurar en n8n
N8N_REVENUE_NEW_INVOICES_WEBHOOK_URL=
N8N_REVENUE_NEW_INVOICES_WEBHOOK_SECRET=

# --- Whitelist de acceso (por-entidad) ---
# Lista de emails autorizados, separados por comas. Chequeada en el login (Auth.js) y
# de nuevo en cada request a /api/trigger. Ejemplo: alguien@dominio.com,otro@dominio.com
# Una misma persona puede tener más de un correo (uno por dominio/empresa): cada uno se carga
# como una entrada más, en la whitelist de cada entidad a la que esa persona deba tener acceso.
EQUALS11_ALLOWED_EMAILS=

# Pestaña Tekton — INC y SAC (los dos workflows del panel) siguen deshabilitados hasta que
# tengan webhook de n8n propio, pero esta whitelist ya controla si la persona ve la pestaña.
TEKTON_ALLOWED_EMAILS=

# --- Auth.js v5 (Google OAuth, sin base de datos) ---
# Secret de sesión. Generar con: npx auth secret
AUTH_SECRET=
# Credenciales del OAuth 2.0 Client ID (Web application) de Google Cloud Console.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Opcional: normalmente autodetectada en Vercel. Setear solo si el callback de OAuth
# falla por URL incorrecta (ej. AUTH_URL=https://tu-dominio.vercel.app).
# AUTH_URL=
