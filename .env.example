# Panel de Triggers — variables de entorno (v1, Equals11)
# Copiar a .env.local para desarrollo, y cargar en Vercel (Production) para el deploy.
# NUNCA commitear valores reales: .env.local y demás .env* están gitignoreados;
# solo este .env.example (sin valores) se versiona.

# --- n8n (workflow "New P&L creation") ---
# URL del webhook de n8n. En producción apunta al webhook real; en pruebas locales
# se puede apuntar a un listener descartable para no disparar el workflow real.
N8N_PLL_WEBHOOK_URL=
# Valor del header X-Webhook-Secret que exige el nodo Webhook en n8n. Server-side only:
# nunca se expone al cliente ni se loguea.
N8N_PLL_WEBHOOK_SECRET=

# --- Whitelist de acceso (por-entidad) ---
# Lista de emails autorizados, separados por comas. Chequeada en el login (Auth.js) y
# de nuevo en cada request a /api/trigger-pnl. Ejemplo: alguien@dominio.com,otro@dominio.com
EQUALS11_ALLOWED_EMAILS=

# --- Auth.js v5 (Google OAuth, sin base de datos) ---
# Secret de sesión. Generar con: npx auth secret
AUTH_SECRET=
# Credenciales del OAuth 2.0 Client ID (Web application) de Google Cloud Console.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Opcional: normalmente autodetectada en Vercel. Setear solo si el callback de OAuth
# falla por URL incorrecta (ej. AUTH_URL=https://tu-dominio.vercel.app).
# AUTH_URL=
